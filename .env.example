# Variables de Entorno - Ejemplo

# Puerto en el que corre la aplicación
PORT=8080

# URI de conexión a MongoDB
# Formato: mongodb://[username:password@]hostname[:port][/[database]]
MONGO_URI=mongodb://localhost:27017

# Nombre de la base de datos
DB_NAME=ecommerce

# Modo de Gin: debug, release, test
GIN_MODE=debug

# Secreto para JWT (cambiar en producción)
JWT_SECRET=your-super-secret-key-change-in-production-12345
